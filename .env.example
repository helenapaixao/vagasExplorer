# Token do GitHub (opcional, recomendado). Aumenta o limite de requisições da
# API (5000/h com token vs 60/h sem).
# Crie em: https://github.com/settings/tokens (não precisa de nenhum escopo)
# GITHUB_TOKEN=ghp_xxxxxxxxxxxx

# Banco usado pela busca global (/vagas) e pelo cron de sync.
# Sem ele o app continua funcionando, mas só com a navegação por repositório.
# Local (SQLite): file:./dev.db
# Produção (Vercel): use Postgres (Neon, Supabase, etc.) e altere o provider em
# prisma/schema.prisma para "postgresql". SQLite não persiste em serverless.
# DATABASE_URL="file:./dev.db"

# Segredo para proteger a rota do cron (o Vercel Cron envia no header
# Authorization: Bearer <CRON_SECRET>)
# CRON_SECRET=um-valor-aleatorio-secreto

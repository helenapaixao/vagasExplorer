# Token do GitHub (opcional). Aumenta o limite de requisições da API (5000/h com token vs 60/h sem).
# Crie em: https://github.com/settings/tokens
# GITHUB_TOKEN=ghp_xxxxxxxxxxxx

# Banco para o cron de sync (vagas vindas do GitHub).
# Local (SQLite): file:./dev.db
# Produção (Vercel): use Postgres (Neon, Supabase, etc.) e altere provider no prisma/schema.prisma para "postgresql"
# DATABASE_URL="file:./dev.db"

# Segredo para proteger a rota do cron (Vercel Cron envia no header Authorization: Bearer <CRON_SECRET>)
# CRON_SECRET=um-valor-aleatorio-secreto

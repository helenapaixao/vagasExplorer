generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Job {
  id             String    @id @default(cuid())
  owner          String
  repo           String
  issueNumber    Int
  title          String
  body           String?
  htmlUrl        String
  userLogin      String
  labels         String?   // JSON string: [{ name, color }]
  githubCreatedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([owner, repo, issueNumber])
  @@index([owner, repo])
}
